class_name Chars
extends RefCounted
# Scene loader + tiny box helpers (used only for bullets / particles, which need per-instance sizes & colors).
# All models, pickups, effects and environment pieces live in res://scenes/*.tscn (generated by tools/gen_scenes.py).

const PLAYER_SCALE := [15, 15, 15, 15, 15, 15, 15, 11, 15, 15, 15, 15, 15, 15, 15]
const BOSS_NAMES := ["bison", "vulture", "coyote", "rattler", "scorpion", "bear"]

static var CACHE := {}
static var BOX: BoxMesh
static var MATS := {}
static var SIL: StandardMaterial3D
static var BJ := 0

# Instance a scene, scale it, and cache handy node references as meta so game code stays simple.
static func inst(path: String, s: float = 1.0) -> Node3D:
	if not CACHE.has(path):
		CACHE[path] = load(path)
	var n: Node3D = CACHE[path].instantiate()
	n.scale = Vector3.ONE * s
	n.set_meta("bs", s)
	var inner = n.get_node_or_null("Inner")
	if inner != null:
		n.set_meta("inner", inner)
		n.set_meta("tail", inner.get_node("Tail"))
		var segs = []
		var wings = []
		for c in inner.get_children():
			if c.name.begins_with("Seg"):
				segs.append(c)
			elif c.name.begins_with("Wing"):
				wings.append(c)
			elif c.name == "Spin":
				n.set_meta("spin", c)
		if segs.size() > 0:
			n.set_meta("segs", segs)
			n.set_meta("s", 1.0)
		if wings.size() > 0:
			n.set_meta("wings", wings)
	return n

static func mat(c) -> StandardMaterial3D:
	var k = str(c)
	if MATS.has(k):
		return MATS[k]
	var m = StandardMaterial3D.new()
	m.albedo_color = Color(c)
	m.roughness = 1.0
	m.metallic_specular = 0.0
	MATS[k] = m
	return m

static func bx(w, h, d, c) -> MeshInstance3D:
	if BOX == null:
		BOX = BoxMesh.new()
		BOX.size = Vector3.ONE
	var m = MeshInstance3D.new()
	m.mesh = BOX
	m.material_override = mat(c)
	var k = 1.0 + fmod(BJ * .6180339887, 1.0) * .012
	BJ += 1
	m.scale = Vector3(w * k, h * k, d * k)
	return m

# Locked-character look: swap every mesh (except the shadow) to a flat dark material.
static func silhouette(n: Node, on: bool) -> void:
	if SIL == null:
		SIL = StandardMaterial3D.new()
		SIL.albedo_color = Color("#1b1b24")
		SIL.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	for c in n.get_children():
		silhouette(c, on)
		if c is MeshInstance3D and not c.is_in_group("shadow"):
			if on:
				c.material_override = SIL
			else:
				c.material_override = null
